# ==================================================================
# FishHaven — environment variables
# REQUIRED to run F1: AUTH_SECRET, NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, and at
# least one auth provider (Google or Resend).
# ==================================================================

# ------------------------------------------------------------------
# Auth.js v5 — REQUIRED
# ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Used to HMAC-sign the profile/admin cookies — the app throws without it.
AUTH_SECRET=

# Leave blank on Vercel (auto). REQUIRED on non-Vercel hosts (the auth
# callback base URL). e.g. https://fishhaven.vercel.app
# NEXTAUTH_URL=https://fishhaven.vercel.app

# ------------------------------------------------------------------
# Auth providers — configure AT LEAST ONE (login is impossible without one)
# ------------------------------------------------------------------
# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic-link email via Resend — https://resend.com
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=FishHaven <no-reply@yourdomain.com>

# ------------------------------------------------------------------
# Supabase — REQUIRED
# ------------------------------------------------------------------
# Public (shipped to the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET (server-only, never expose to the browser). REQUIRED: the F1 identity/
# activity/strike RPCs have EXECUTE revoked from anon and granted only to
# service_role, so the server calls them with this key. The Auth.js Supabase
# adapter (email magic-link) also needs it.
SUPABASE_SERVICE_ROLE_KEY=
