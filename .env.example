# ------------------------------------------------------------------
# Auth.js v5 — required
# ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Leave blank locally; set on Vercel to your production URL (auto on Vercel)
# NEXTAUTH_URL=https://haven-kids.vercel.app

# ------------------------------------------------------------------
# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# ------------------------------------------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ------------------------------------------------------------------
# Magic-link email via Resend — https://resend.com
# ------------------------------------------------------------------
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=Haven Kids <no-reply@yourdomain.com>

# ------------------------------------------------------------------
# Supabase (activity sheet + auth adapter tables)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
